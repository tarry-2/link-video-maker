{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "src",
    "lib",
    "server.ts",
    "tests"
  ]
}
