PORT=3000
ADMIN_PASSWORD=change-this-to-a-long-random-password
APP_SECRET=replace-with-64-random-hex-characters

# (선택) 자막(libass) 지원 ffmpeg 경로.
# 시스템 ffmpeg에 자막 기능이 없을 때만 지정하면 됩니다.
# macOS(Homebrew): brew install ffmpeg-full  후 아래 경로 사용
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# Docker/리눅스는 자막 지원 ffmpeg가 기본 포함되어 지정할 필요가 없습니다.

# (선택) 자막 한글 폰트 이름. 기본값 자동(맥=Apple SD Gothic Neo, 그 외=Noto Sans CJK KR)
# SUBTITLE_FONT=Apple SD Gothic Neo
